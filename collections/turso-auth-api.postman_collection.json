                          },
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "body": {
                          "mode": "raw",
                          "raw": "{\n  \"organization\": \"<string>\",\n  \"group\": \"<string>\",\n  \"scopes\": [\n    \"db:create\",\n    \"group:rotate-creds\"\n  ]\n}",
                          "options": {
                            "raw": {
                              "headerFamily": "json",
                              "language": "json"
                            }
                          }
                        },
                        "url": {
                          "raw": "{{baseUrl}}/v1/auth/api-tokens/:tokenName",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "v1",
