                      "name": "Create API Token",
                      "id": "bf9028a3-3272-4dbc-a763-c518f55cc3fc",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "POST",
                        "header": [
